# Canonical origin, no trailing slash. Baked in at build time.
NEXT_PUBLIC_SITE_URL=https://voiyu.com

# Development only: where the learning page reads and writes progress. Run
# `node scripts/dev-progress-server.mjs`, then put this in .env.development.local.
# Leave it unset for production builds: the page then uses /api/progress.php.
# NEXT_PUBLIC_PROGRESS_API=http://localhost:8787/progress
