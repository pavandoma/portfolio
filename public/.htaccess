# Serving the Next.js static export from Apache / LiteSpeed (Hostinger).
# This file is copied verbatim into out/ at build time.

Options -Indexes

# Serve the exported page first; Hostinger's placeholder default.php may
# still sit in the web root.
DirectoryIndex index.html index.php

# Short address for the agent (MCP) endpoint: /mcp runs api/mcp.php.
# An internal rewrite, not a redirect, so POST bodies arrive intact.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^mcp/?$ api/mcp.php [L]

  # Addresses from the old WordPress site that search engines still list:
  # send them, permanently, to the matching part of the new home page.
  # (Not /home/: browsers that remember WordPress's old "/" -> "/home/"
  # redirect would loop; /home/ serves the home page instead.)
  RewriteRule ^about/?$ /#about [R=301,L,NE]
  RewriteRule ^(projects|project)(/.*)?$ /#projects [R=301,L,NE]
  RewriteRule ^contact/?$ /#contact [R=301,L,NE]
  RewriteRule ^blog/?$ /#blogs [R=301,L,NE]
  RewriteRule ^(hello-world|sample-page|shop|cart|checkout|my-account|privacy-policy|category|tag|author|feed|comments|wp-admin|wp-login\.php|wp-content|wp-includes|xmlrpc\.php)(/.*)?$ / [R=301,L]
</IfModule>

# Next.js writes its not-found page to /404.html.
ErrorDocument 404 /404.html

# The share image route has no extension; without this the server sends it
# as application/octet-stream and social crawlers refuse to render it.
<Files "opengraph-image">
  ForceType image/png
</Files>

# Browser-side protections for every response. No Content-Security-Policy here:
# the host already sends upgrade-insecure-requests, and the static export relies
# on inline scripts that a strict policy would block.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Build assets under /_next/static are content-hashed: cache them forever.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
