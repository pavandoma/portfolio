# Serving the Next.js static export from Apache / LiteSpeed (Hostinger).
# This file is copied verbatim into out/ at build time.

Options -Indexes

# Short address for the agent (MCP) endpoint: /mcp runs api/mcp.php.
# An internal rewrite, not a redirect, so POST bodies arrive intact.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^mcp/?$ api/mcp.php [L]
</IfModule>

# Next.js writes its not-found page to /404.html.
ErrorDocument 404 /404.html

# The share image route has no extension; without this the server sends it
# as application/octet-stream and social crawlers refuse to render it.
<Files "opengraph-image">
  ForceType image/png
</Files>

# Browser-side protections for every response. No Content-Security-Policy here:
# the host already sends upgrade-insecure-requests, and the static export relies
# on inline scripts that a strict policy would block.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Build assets under /_next/static are content-hashed: cache them forever.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
