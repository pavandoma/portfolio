# Copy to .env and fill in what you need. .env is git-ignored; never commit it.
# Read by docker-compose and by the backend when run locally (resume-platform/.env).

# --- Docker Compose only -----------------------------------------------------
# Database password for the bundled PostgreSQL container (letters and digits are simplest).
POSTGRES_PASSWORD=

# --- Access ------------------------------------------------------------------
# Optional bearer token for the backend API. When set, the Next.js server adds it to
# proxied requests (BACKEND_API_TOKEN), so the browser never sees it.
RIP_API_TOKEN=

# --- Job posting fetch (optional) --------------------------------------------
# Without a key, URLs are fetched by the built-in fetcher (public addresses only).
FIRECRAWL_API_KEY=
# Raises the GitHub API rate limit for repository evidence lookups.
GITHUB_TOKEN=

# --- Language model (optional) -------------------------------------------------
# none | anthropic | openai | ollama. Everything works with "none"; a model only adds
# wording suggestions, which are fact-checked and need your approval.
LLM_PROVIDER=none
# Leave empty for the provider default (anthropic: claude-opus-5-5). Required for openai/ollama.
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# From inside Docker, a model served on your machine is at host.docker.internal.
OLLAMA_BASE_URL=http://localhost:11434

# Must be true before any profile or resume text is sent to a remote model or an external
# validator. Local Ollama and local validators do not need it.
RIP_ALLOW_EXTERNAL_DATA_SHARING=false

# --- External validators (optional) --------------------------------------------
# Path to an MCP validator config, e.g. examples/mcp-validators.example.json
RIP_MCP_CONFIG=

# --- Limits ------------------------------------------------------------------
RIP_MAX_REVISION_CYCLES=3
RIP_MAX_UPLOAD_BYTES=10485760
